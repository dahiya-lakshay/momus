# Data (generated by data/download.py, data/forge.py, data/dataset.py — never hand-edited)
data/raw/
data/clean/
data/forged/
data/splits/

# Model checkpoints (large binaries, regenerated by model/train.py)
checkpoints/*.pt
checkpoints/history.json

# Deploy artifacts (regenerated by deploy/export_onnx.py, deploy/quantize.py)
deploy/artifacts/

# Results (regenerated by eval/*.py — keep the directory structure via .gitkeep if needed)
results/*.png
results/*.md
results/*.json
results/failures/*.png

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# W&B (optional experiment logging)
wandb/

# Editors
.vscode/
.idea/
